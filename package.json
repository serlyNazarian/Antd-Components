{
  "name": "my-ui-lib-ubicross",
  "version": "1.1.3",
  "description": "My reusable React UI components",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./icons": {
      "import": "./dist/icons.mjs",
      "require": "./dist/icons.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "react",
    "ui",
    "components"
  ],
  "author": "Serly Nazarian",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "antd": ">=5",
    "react": ">=18",
    "react-i18next": ">=11",
    "react-router-dom": "^6"
  },
  "devDependencies": {
    "tsup": "^8.5.1"
  },
  "dependencies": {
    "lucide-react": "^1.64.0"
  }
}
